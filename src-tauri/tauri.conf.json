{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kapsule",
  "version": "1.0.3",
  "identifier": "Kapsule",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kapsule",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1OUIxNUIzOTc1RkZEODkKUldTSi9WK1hzeFdiVlhqUW1XZ0lvUjMySGM5ZzM4cUJzbGFUbzRub2cxRFBzZU5iUTVlMmFrRksK",
      "endpoints": [
        "https://github.com/HenriAku/Kapsule/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
